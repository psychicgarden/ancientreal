{
  "name": "ancient-smart-contracts-tests",
  "version": "1.0.0",
  "description": "Comprehensive test suite for Ancient smart contracts",
  "scripts": {
    "test": "npx hardhat test",
    "test:mortgage": "npx hardhat test test/AncientMortgage.test.js",
    "test:escrow": "npx hardhat test test/DeveloperEscrowManager.test.js", 
    "test:pool": "npx hardhat test test/EnhancedStakingPool.test.js",
    "test:integration": "npx hardhat test test/Integration.test.js",
    "test:all": "npx hardhat test --verbose",
    "coverage": "npx hardhat coverage",
    "compile": "npx hardhat compile"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "chai": "^4.2.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.4.0",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.1",
    "typechain": "^8.3.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
